{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRG Hotspot",
  "version": "0.1.0",
  "identifier": "app1oneme.vrghotspot",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRG Hotspot",
        "width": 452,
        "height": 820,
        "minWidth": 452,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["assets/icons/icon.png", "assets/icons/icon.ico"]
  }
}
